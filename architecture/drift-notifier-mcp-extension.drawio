                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r-callout" value="1ページ目との違い&#xa;Cognitoグループ+Precedenceは「役職という人間の序列」で判定する。&#xa;この版はIAMのSimulatePrincipalPolicy APIを使い、「承認者が実際にその権限を持っているか」という&#xa;権限の実質で判定する。役職に頼らず最小権限の考え方に忠実だが、ポリシー比較のロジックが必要になる分、実装は複雑になる。&#xa;承認者のIAM ARNは、1ページ目と同じくCognitoの属性 custom:iam_arn から取得する。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FBEAD6;strokeColor=#8A5A17;fontColor=#6E4110;fontSize=12;align=left;verticalAlign=top;spacing=12;" parent="r1" vertex="1">
                    <mxGeometry x="30" y="770" width="1000" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
