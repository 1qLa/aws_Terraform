<mxfile host="app.diagrams.net"><diagram name="Cognitoの全体像" id="cognito"><mxGraphModel dx="1200" dy="720" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Cognito User Pool（kane-drift-users）　ログインを担当する土台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d86613;fontSize=16;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="540" height="660" as="geometry"/></mxCell><mxCell id="c3" value="ユーザー（田中・佐藤・鈴木）&lt;br&gt;ログインID：メールアドレス&lt;br&gt;custom:iam_arn：本人のAWS上のARN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d86613;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="95" width="250" height="120" as="geometry"/></mxCell><mxCell id="c4" value="グループ&lt;br&gt;leads（Precedence 10）上&lt;br&gt;developers（20）下&lt;br&gt;数字が小さいほど権限が上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d86613;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="580" y="95" width="240" height="120" as="geometry"/></mxCell><mxCell id="c5" value="スコープ drift-gateway/notify&lt;br&gt;（2LO のトークンに付く「通知Toolを呼べる」権限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d86613;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="500" height="60" as="geometry"/></mxCell><mxCell id="c6" value="アプリクライアント：どのアプリが、どの方式でログインするか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="320" y="305" width="500" height="30" as="geometry"/></mxCell><mxCell id="c7" value="drift-handler 用　2LO（client_credentials）&lt;br&gt;アプリ自身の権限／シークレットあり" style="rounded=1;whiteSpace=wrap;html